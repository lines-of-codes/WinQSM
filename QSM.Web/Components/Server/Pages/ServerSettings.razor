@page "/Server/{Id:int:min(0)}/Settings"
@using QSM.Web.Components.Shared

<PageTitle>Settings - QSM Web Console</PageTitle>

<h1>Server Settings</h1>

<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
    <div class="col">
        <LinkCard TitleIcon="bi-globe"
                  Title="World Generation"
                  Description="Manage your world generation settings."
                  href=@($"Server/{Id}/Settings/World") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-controller"
                  Title="Gameplay Settings"
                  Description="Adjust the game's difficulty & similar options."
                  href=@($"Server/{Id}/Settings/Gameplay") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-bar-chart"
                  Title="Server Performance"
                  Description="Settings important to the server's performance."
                  href=@($"Server/{Id}/Settings/Performance") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-router"
                  Title="Network Settings"
                  Description="Network-related options, such as the IP and Port."
                  href=@($"Server/{Id}/Settings/Network") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-people"
                  Title="Player Interactions"
                  Description="Manage how the player interacts with the world."
                  href=@($"Server/{Id}/Settings/Interactions") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-lock"
                  Title="Server Security"
                  Description="Settings which may affect the server's security, 
                  such as online mode."
                  href=@($"Server/{Id}/Settings/Security") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-terminal"
                  Title="Java"
                  Description="Change settings related to the Java install used for this instance."
                  href=@($"Server/{Id}/Settings/Java") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-archive"
                  Title="Backups"
                  Description="Manage & change settings regarding backups."
                  href=@($"Server/{Id}/Settings/Backups") />
    </div>
    <div class="col">
        <LinkCard TitleIcon="bi-three-dots"
                  Title="Miscellaneous"
                  Description="Other settings such as the MOTD, idle timeout, rate
                               limiting, and resource packs."
                  href=@($"Server/{Id}/Settings/Misc") />
    </div>
</div>

<style>
    .card {
        height: 100%;
    }
    
    .card-body {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }
</style>

@code {
    
    [Parameter]
    public int Id { get; set; }
    
}